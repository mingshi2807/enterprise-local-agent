{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enterprise Local Agent",
  "identifier": "com.enterprise-local-agent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Enterprise Local Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "Enterprise Local Agent contributors",
    "homepage": "https://github.com/mingshi2807/enterprise-local-agent",
    "category": "DeveloperTool",
    "shortDescription": "Governed local enterprise agent desktop client",
    "longDescription": "A thin desktop client for the separately installed Enterprise Local Agent service.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
